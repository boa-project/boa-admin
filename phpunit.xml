<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="unit">
            <directory>tests</directory>
            <exclude>tests/Http</exclude>
        </testsuite>
        <!-- Explicit order: login → registry → conf → lom → fs fixtures → dco → prefs → smoke → logout -->
        <testsuite name="http">
            <file>tests/Http/Http01AuthBootTest.php</file>
            <file>tests/Http/Http02RegistryGuiTest.php</file>
            <file>tests/Http/Http03ConfAdminTest.php</file>
            <file>tests/Http/Http04MetaLomTest.php</file>
            <file>tests/Http/Http05DcoFsTest.php</file>
            <file>tests/Http/Http06DcoObjectTest.php</file>
            <file>tests/Http/Http07UserPrefsTest.php</file>
            <file>tests/Http/Http08ShareMiscTest.php</file>
            <file>tests/Http/Http08bActionSmokeTest.php</file>
            <file>tests/Http/Http09SessionEndTest.php</file>
        </testsuite>
        <testsuite name="boa-admin">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
